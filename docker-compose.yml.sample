services:
  bangou-api:
    image: ${API_IMAGE:-192.168.0.110:5000/bangou-api:latest}
    container_name: bangou-api
    volumes:
      - /mnt/hd1/Download:/mnt/hd1/Download:rw
      - /mnt/hd1/Multimedia:/mnt/hd1/Multimedia:rw
      - /opt/bangou:/data
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Asia/Tokyo
    command:
      - --db=/data/bangou.db
      - --listen=:8080
    # Give in-flight mkvmerge merges time to finish on SIGTERM (the app
    # waits up to 14m before exiting).
    stop_grace_period: 15m
    restart: unless-stopped

  bangou-web:
    image: ${WEB_IMAGE:-192.168.0.110:5000/bangou-web:latest}
    container_name: bangou-web
    ports:
      - "8890:80"
    depends_on:
      - bangou-api
    restart: unless-stopped
